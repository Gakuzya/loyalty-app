generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  BARISTA
  CUSTOMER
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())

  network   Network? @relation("OwnerNetwork")
  branchId  String?
  branch    Branch?  @relation("BaristaBranch", fields: [branchId], references: [id])
  tier      CustomerTier @default(BRONZE)

  stampsGiven    Transaction[] @relation("BaristaTransactions")
  stampsReceived Transaction[] @relation("CustomerTransactions")
}

model Network {
  id           String   @id @default(uuid())
  ownerId      String   @unique
  owner        User     @relation("OwnerNetwork", fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  targetStamps Int      @default(6)
  rewardTitle  String   @default("Бесплатный кофе")
  branches     Branch[]
  kpiTargets   KpiTarget[]
}

model Branch {
  id        String   @id @default(uuid())
  networkId String
  network   Network  @relation(fields: [networkId], references: [id], onDelete: Cascade)
  name      String
  slug      String   @unique
  address   String?
  staff        User[]        @relation("BaristaBranch")
  transactions Transaction[]
}

model KpiTarget {
  id          String   @id @default(uuid())
  networkId   String
  network     Network  @relation(fields: [networkId], references: [id], onDelete: Cascade)
  title       String   
  targetCount Int      
  reward      String   
  activeMonth DateTime 
}

enum TransactionType {
  EARN_STAMP
  REDEEM_REWARD
}

model Transaction {
  id         String   @id @default(uuid())
  type       TransactionType @default(EARN_STAMP)
  customerId String
  customer   User     @relation("CustomerTransactions", fields: [customerId], references: [id])
  baristaId  String
  barista    User     @relation("BaristaTransactions", fields: [baristaId], references: [id])
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id])
  createdAt  DateTime @default(now())
}
